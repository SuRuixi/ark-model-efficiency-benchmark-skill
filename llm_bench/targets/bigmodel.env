# 目标配置：智谱 BigModel（目标名：bigmodel）
#
# 接入方式：cp targets/_template.env targets/bigmodel.env 后填值；
# 自检通过后运行 ./run_prefix_repetition.sh bigmodel。

# 保留终端中已 export 的 BIGMODEL_API_KEY；未设置时为空。
# 也可将下一行改为 export BIGMODEL_API_KEY="实际密钥"（打包前务必恢复）。
export BIGMODEL_API_KEY="${BIGMODEL_API_KEY:-}"
export BIGMODEL_BASE_URL="https://open.bigmodel.cn/api/paas/v4/chat/completions"

# ---- 本文件专属的目标配置；不要在终端全局 export TARGET_MODEL ----
export TARGET_LABEL="bigmodel"
export TARGET_MODEL="glm-5.2"   # TODO: 按需换成实测的模型 ID（glm-4.6 / glm-5.x 系列）
export TARGET_BASE_URL="$BIGMODEL_BASE_URL"
export TARGET_API_KEY_ENV="BIGMODEL_API_KEY"

# ---- 可选项（按智谱协议差异）----
# 智谱 OpenAI 兼容层只认 max_tokens（不认 max_completion_tokens，
# 不认的字段会被静默忽略导致输出不封顶），必须显式指定
export TARGET_OUTPUT_PARAM="max_tokens"
# 基线默认发送 thinking.type=disabled。
# 注意：GLM-5.3 / 5.3-FLASH 是强制思考模型，thinking.type=disabled 会被 4xx 拒绝，
# 须取消下面两行注释，并先跑 connectivity 自检确认：
#export TARGET_THINKING="enabled"
#export TARGET_REASONING_EFFORT="low"
