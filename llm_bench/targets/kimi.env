# 目标配置：月之暗面 Kimi（目标名：kimi）
#
# 接入方式：cp targets/_template.env targets/kimi.env 后填值；
# 自检通过后运行 ./run_prefix_repetition.sh kimi。

# 保留终端中已 export 的 KIMI_API_KEY；未设置时为空。
# 也可将下一行改为 export KIMI_API_KEY="实际密钥"（打包前务必恢复）。
export KIMI_API_KEY="${KIMI_API_KEY:-}"
export KIMI_BASE_URL="https://api.moonshot.cn/v1/chat/completions"   # 国内平台(platform.moonshot.cn)的 key 走 .cn；国际站 key 才用 api.moonshot.ai

# ---- 本文件专属的目标配置；不要在终端全局 export TARGET_MODEL ----
export TARGET_LABEL="kimi"
export TARGET_MODEL="kimi-k2.6"   # TODO: 按需换成实测的模型 ID
export TARGET_BASE_URL="$KIMI_BASE_URL"
export TARGET_API_KEY_ENV="KIMI_API_KEY"

# ---- 可选项（按 Moonshot 协议差异）----
# Moonshot 只认 max_tokens（不认 max_completion_tokens），必须显式指定，
# 否则输出不封顶、对比失真
export TARGET_OUTPUT_PARAM="max_tokens"
# 基线默认发送 thinking.type=disabled。若切换到强制思考模型，需按模型要求显式
# 配置 TARGET_THINKING=enabled 和 TARGET_REASONING_EFFORT。
