# ============================================================
# 压测目标模板：复制为 targets/<目标名>.env 后填值
#
# 用法：
#   1. cp targets/_template.env targets/mytarget.env
#   2. 把下面 <...> 占位符替换成该厂商的实际值，并取消对应行注释
#   3. 按下方注释选择从终端继承 Key，或直接在目标文件中填写
#   4. ./run_connectivity.sh mytarget
#   5. 自检通过后：./run_prefix_repetition.sh mytarget
#   6. run 脚本会自检：占位符没替换 / key 变量名没改会直接报错拦下
#
# 目标名就是文件名去掉 .env 的部分。先自检 1 个请求验证地址、密钥、
# 模型 ID 和思考状态，再开始正式压测。
# ============================================================

# ---- ① 厂商凭据与地址 ----
# ${VAR:-} 表示保留终端中已 export 的值，未设置时为空。
# 也可将下一行改为 export <厂商大写标识>_API_KEY="实际密钥"；
# 对外打包前必须恢复为不含密钥的写法。
#export <厂商大写标识>_API_KEY="${<厂商大写标识>_API_KEY:-}"
#export <厂商大写标识>_BASE_URL="https://厂商地址/chat/completions"

# ---- ② 本文件专属的目标配置（以下 TARGET_* 变量名不要改）----
# TARGET_MODEL 只在本文件内配置，不要在终端全局 export；多目标压测会分别加载
# 每个 targets/<目标名>.env，并立即保存该目标的模型。
# TARGET_LABEL         报告/图例显示名（如 "阿里云"）
#export TARGET_LABEL="显示名"

# TARGET_MODEL         厂商侧模型 ID。注意：很多厂商只认滚动别名、拒绝版本号 ID
#                    （如 DeepSeek 官方只接受 deepseek-v4-flash），填错会 404/400
#export TARGET_MODEL="厂商侧模型ID"

# TARGET_BASE_URL      厂商 API 地址（指向 ① 里定义的变量）
#export TARGET_BASE_URL="$<厂商大写标识>_BASE_URL"

# TARGET_API_KEY_ENV   上面 API Key 的变量名字符串
#export TARGET_API_KEY_ENV="<厂商大写标识>_API_KEY"

# ---- ③ 可选项（按厂商协议差异保留或删除）----
# TARGET_OUTPUT_PARAM  输出封顶字段名：OpenAI 标准厂商用 max_completion_tokens
#                    （删掉本行即默认）；只认 max_tokens 的厂商（DeepSeek 等）必须
#                    显式设 max_tokens--不认的字段会被静默忽略，导致输出不封顶、
#                    对比失真。不确定时先自检 1 个请求看输出 token 是否被截到上限。
#export TARGET_OUTPUT_PARAM="max_tokens"

# TARGET_THINKING      缺省统一发送 disabled；强制思考模型才需要覆盖为 enabled
#export TARGET_THINKING="enabled"

# TARGET_REASONING_EFFORT  缺省不发送；模型要求时显式填写 none/low/high/max 等
#export TARGET_REASONING_EFFORT="low"

# TARGET_MAX_COMPLETION_TOKENS  可选：覆盖该目标的单次输出上限；
#                              CLI --max-completion-tokens 会统一覆盖所有目标
#export TARGET_MAX_COMPLETION_TOKENS="1024"
