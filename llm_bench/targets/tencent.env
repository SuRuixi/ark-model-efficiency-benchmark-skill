# 目标配置：腾讯云大模型服务平台 TokenHub（目标名：tencent）
#
# 可用模型以 GET /v1/models 返回的 status=online 列表为准：
#   curl "https://tokenhub.tencentmaas.com/v1/models" \
#     -H "Authorization: Bearer $TOKENHUB_API_KEY"

# 保留终端中已 export 的 TOKENHUB_API_KEY；未设置时为空。
# 也可将下一行改为 export TOKENHUB_API_KEY="实际密钥"（打包前务必恢复）。
export TOKENHUB_API_KEY="${TOKENHUB_API_KEY:-}"
export TENCENT_TOKENHUB_BASE_URL="https://tokenhub.tencentmaas.com/v1"

# ---- ② 本文件专属的目标配置；不要在终端全局 export TARGET_MODEL ----
export TARGET_LABEL="腾讯云"
# 与方舟 deepseek-v4-flash-ga-260731 对应同一 DeepSeek-V4-Flash 0731 版本。
# 若账号未开通该模型，请从 /v1/models 的 online 项中选择并替换。
export TARGET_MODEL="deepseek-v4-flash-0731"
export TARGET_BASE_URL="$TENCENT_TOKENHUB_BASE_URL"
export TARGET_API_KEY_ENV="TOKENHUB_API_KEY"

# 基线默认发送 thinking.type=disabled，当前模型不发送 reasoning_effort。
# 切换到强制思考的 glm-5.3 时须同时启用：
#export TARGET_THINKING="enabled"
#export TARGET_REASONING_EFFORT="low"
