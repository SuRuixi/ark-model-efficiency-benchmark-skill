# 目标配置：DeepSeek 官方（目标名：deepseek）
#
# 接入新目标时：cp targets/_template.env targets/mytarget.env，按模板填值，
# 然后运行 ./run_prefix_repetition.sh mytarget。

# 保留终端中已 export 的 DEEPSEEK_API_KEY；未设置时为空。
# 也可将下一行改为 export DEEPSEEK_API_KEY="实际密钥"（打包前务必恢复）。
export DEEPSEEK_API_KEY="${DEEPSEEK_API_KEY:-}"
export DEEPSEEK_BASE_URL="https://api.deepseek.com/chat/completions"

# ---- 本文件专属的目标配置；不要在终端全局 export TARGET_MODEL ----
# TARGET_LABEL         报告/图例显示名
# TARGET_MODEL         厂商侧模型 ID（注意：很多厂商只认滚动别名、拒绝版本号 ID，
#                    DeepSeek 官方 API 就只接受 deepseek-v4-flash 等别名；
#                    此处对应与方舟 DeepSeek-V4-Flash-ga-260731 同代模型）
# TARGET_BASE_URL      厂商 API 地址
# TARGET_API_KEY_ENV   上面 API Key 的变量名字符串
# TARGET_OUTPUT_PARAM  输出封顶参数字段名：OpenAI 标准厂商用 max_completion_tokens
#                    （删掉本行即默认）；DeepSeek 等只认 max_tokens 的厂商必须保留
#                    max_tokens--不认的字段会被静默忽略，导致输出不封顶、对比失真
# TARGET_THINKING      DeepSeek 风格思考开关 disabled/enabled（DeepSeek 默认即
#                    disabled，无需发送；需要显式关思考的厂商再启用）
export TARGET_LABEL="DeepSeek"
export TARGET_MODEL="deepseek-v4-flash"
export TARGET_BASE_URL="$DEEPSEEK_BASE_URL"
export TARGET_API_KEY_ENV="DEEPSEEK_API_KEY"
export TARGET_OUTPUT_PARAM="max_tokens"
