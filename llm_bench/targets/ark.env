# 目标配置：火山方舟 Ark（目标名：ark）

# 保留终端中已 export 的 ARK_API_KEY；未设置时为空。
# 也可将下一行改为 export ARK_API_KEY="实际密钥"（打包前务必恢复）。
export ARK_API_KEY="${ARK_API_KEY:-}"
export ARK_BASE_URL="${ARK_BASE_URL:-https://ark.cn-beijing.volces.com/api/v3}"

# 本文件专属的目标配置；不要在终端全局 export TARGET_MODEL。
export TARGET_LABEL="ark"
export TARGET_MODEL="deepseek-v4-flash-ga-260731"
export TARGET_BASE_URL="$ARK_BASE_URL"
export TARGET_API_KEY_ENV="ARK_API_KEY"

# 基线由脚本统一发送 thinking.type=disabled，不额外发送 reasoning_effort。
# 注意：GLM-5.3 / 5.3-FLASH 是强制思考模型，thinking.type=disabled 会被 4xx 拒绝，
# 须取消下面两行注释，并先跑 connectivity 自检确认：
#export TARGET_THINKING="enabled"
#export TARGET_REASONING_EFFORT="low"
