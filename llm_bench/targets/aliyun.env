# 目标配置：阿里云 DashScope（目标名：aliyun）
# 生成方式：cp targets/_template.env 后填空；自检通过后可正式压测。
# 保留终端中已 export 的 ALIYUN_API_KEY；未设置时为空。
# 也可将下一行改为 export ALIYUN_API_KEY="实际密钥"（打包前务必恢复）。
export ALIYUN_API_KEY="${ALIYUN_API_KEY:-}"
export ALIYUN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions"

# ---- ② 本文件专属的目标配置；不要在终端全局 export TARGET_MODEL ----
export TARGET_LABEL="aliyun"
export TARGET_MODEL="deepseek-v4-flash-0731"
export TARGET_BASE_URL="$ALIYUN_BASE_URL"
export TARGET_API_KEY_ENV="ALIYUN_API_KEY"

# 阿里 OpenAI 兼容接口接受统一的 thinking.type=disabled，脚本会默认发送；
# 当前模型不需要额外的 reasoning_effort。
# 注意：GLM-5.3 / 5.3-FLASH 是强制思考模型，thinking.type=disabled 会被 4xx 拒绝，
# 须取消下面两行注释，并先跑 connectivity 自检确认：
#export TARGET_THINKING="enabled"
#export TARGET_REASONING_EFFORT="low"
