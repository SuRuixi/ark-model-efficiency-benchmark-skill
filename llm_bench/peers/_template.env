# ============================================================
# 友商接入模板（填空题）：cp 本文件为 peers/<厂商名>.env 后填值
#
# 用法：
#   1. cp peers/_template.env peers/aliyun.env
#   2. 把下面 <...> 占位符替换成该厂商的实际值，并取消对应行注释
#      （两处 <厂商大写标识> 保持一致，如 ALIYUN；ALIYUN_API_KEY 也要一致）
#   3. PEER=aliyun ./run_prefix.sh   # <厂商名> = 文件名去掉 .env
#   4. run 脚本会自检：占位符没替换 / key 变量名没改会直接报错拦下
#
# 先自检再压测：PEER 配好后先跑 1 个请求验证地址/密钥/模型 ID，
# 见 README「单独压测第三方服务」一节
# ============================================================

# ---- ① 厂商凭据（变量名换成厂商自己的，避免多厂商互相覆盖）----
#export <厂商大写标识>_API_KEY="sk-..."
#export <厂商大写标识>_BASE_URL="https://厂商地址/chat/completions"

# ---- ② 对比目标配置（以下 PEER_* 变量名不要改，run 脚本按这些名字读）----
# PEER_LABEL         报告/图例显示名（如 "阿里云"）
#export PEER_LABEL="显示名"

# PEER_MODEL         厂商侧模型 ID。注意：很多厂商只认滚动别名、拒绝版本号 ID
#                    （如 DeepSeek 官方只接受 deepseek-v4-flash），填错会 404/400
#export PEER_MODEL="厂商侧模型ID"

# PEER_BASE_URL      厂商 API 地址（指向 ① 里定义的变量）
#export PEER_BASE_URL="$<厂商大写标识>_BASE_URL"

# PEER_API_KEY_ENV   ① 里 key 变量名的字符串（推荐，key 不进命令行历史）
#export PEER_API_KEY_ENV="<厂商大写标识>_API_KEY"

# ---- ③ 可选项（按厂商协议差异保留或删除）----
# PEER_OUTPUT_PARAM  输出封顶字段名：OpenAI 标准厂商用 max_completion_tokens
#                    （删掉本行即默认）；只认 max_tokens 的厂商（DeepSeek 等）必须
#                    显式设 max_tokens--不认的字段会被静默忽略，导致输出不封顶、
#                    对比失真。不确定时先自检 1 个请求看输出 token 是否被截到上限。
#export PEER_OUTPUT_PARAM="max_tokens"

# PEER_THINKING      DeepSeek 风格思考开关 disabled/enabled（仅 DeepSeek 系协议需要，
#                    其余厂商删除本行）
#export PEER_THINKING="disabled"
